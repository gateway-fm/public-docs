{
  "name": "docs-gateway-fm",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "openapi": "docusaurus openapi-docs",
    "openapi:generate:eth": "docusaurus gen-api-docs eth && node scripts/inject-api-method-list.js",
    "openapi:generate:zkevm": "docusaurus gen-api-docs zkevm && node scripts/inject-api-method-list.js",
    "openapi:generate:txpool": "docusaurus gen-api-docs txpool && node scripts/inject-api-method-list.js",
    "openapi:generate:all": "yarn openapi:generate:eth && yarn openapi:generate:zkevm && yarn openapi:generate:txpool",
    "openapi:clean": "docusaurus clean-api-docs"
  },
  "dependencies": {
    "@docusaurus/core": "3.7.0",
    "@docusaurus/preset-classic": "3.7.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "docusaurus-plugin-openapi-docs": "^4.4.0",
    "docusaurus-theme-openapi-docs": "^4.4.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.7.0",
    "@docusaurus/tsconfig": "3.7.0",
    "@docusaurus/types": "3.7.0",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "resolutions": {
    "glob": "^10.5.0",
    "sitemap": "^9.0.0",
    "webpack-dev-server": "5.2.1",
    "uuid": "^14.0.0",
    "js-yaml": "^4.1.1",
    "yaml": "^1.10.3"
  }
}
